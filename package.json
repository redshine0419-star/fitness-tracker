{
  "name": "sponsor-org-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:todo": "node scripts/check-todo.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run check:tokens && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.47.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "typescript": "^5"
  }
}
